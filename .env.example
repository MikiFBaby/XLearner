# Database (PostgreSQL - Neon or Supabase)
DATABASE_URL="postgresql://user:password@host:5432/xlearner?sslmode=require"

# NextAuth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-at-least-32-characters-long"

# Twitter/X OAuth 2.0
# Get these from https://developer.twitter.com/en/portal/dashboard
TWITTER_CLIENT_ID="your-twitter-client-id"
TWITTER_CLIENT_SECRET="your-twitter-client-secret"

# Anthropic Claude API
# Get this from https://console.anthropic.com/
ANTHROPIC_API_KEY="sk-ant-your-api-key"

# ElevenLabs Text-to-Speech (Optional - for audio generation)
# Get this from https://elevenlabs.io/
ELEVENLABS_API_KEY="your-elevenlabs-api-key"
ELEVENLABS_VOICE_ID="21m00Tcm4TlvDq8ikWAM"

# Upstash Redis (Optional - for rate limiting and caching)
# Get these from https://upstash.com/
UPSTASH_REDIS_REST_URL="https://your-redis-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-redis-token"

# Cloudflare R2 Storage (Optional - for audio files)
# Get these from Cloudflare dashboard
R2_ACCOUNT_ID="your-account-id"
R2_ACCESS_KEY_ID="your-access-key-id"
R2_SECRET_ACCESS_KEY="your-secret-access-key"
R2_BUCKET_NAME="xlearner-media"

# Environment
NODE_ENV="development"
